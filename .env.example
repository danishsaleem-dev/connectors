# Anthropic — chat widget (Phase 2)
ANTHROPIC_API_KEY=

# Neon Postgres — portal (Phase 3)
DATABASE_URL=

# Resend — enquiry and quick-contact form delivery.
# Without this set, submissions are accepted and logged server-side but no
# email is sent. Get a key at https://resend.com, verify a sending domain,
# then set this before launch.
RESEND_API_KEY=
# Must be an address on a domain verified with Resend.
CONTACT_FROM_EMAIL=
