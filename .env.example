# The chat widget needs no key. Every answer it can give is written in
# src/lib/chat/knowledge.ts and matched locally — no model, no API, no cost.

# Portal — any standard Postgres connection string works (Neon, Supabase,
# Railway, a local instance). Not locked to one provider.
DATABASE_URL=

# Portal session cookies are HMAC-signed with this. Generate one with
# `openssl rand -hex 32` and never reuse it across environments.
AUTH_SECRET=

# Portal — creates (or resets) the first admin account: `npm run db:seed`.
# Every other portal account is created by an admin from inside the portal.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Property listings — address autocomplete + map pin. Without this, the
# property form falls back to plain city/country/address text fields.
# Create a key at https://console.cloud.google.com (enable "Maps JavaScript
# API" and "Places API"), and restrict it to your domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Property listings — real photo/video upload. Without these, the property
# form falls back to paste-in links (same pattern as Documents).
# Create a Blob store from your Vercel project's Storage tab, which gives
# you the token; then set the second var to "true" to switch the UI over.
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_ENABLE_FILE_UPLOAD=

# Resend — enquiry and quick-contact form delivery.
# Without this set, submissions are accepted and logged server-side but no
# email is sent. Get a key at https://resend.com, verify a sending domain,
# then set this before launch.
RESEND_API_KEY=
# Must be an address on a domain verified with Resend.
CONTACT_FROM_EMAIL=
